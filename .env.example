# Copy to .env and fill in. .env is never committed.

# The model the AI steps use: reading a statement, the chat that records declarations.
# Any OpenAI-compatible endpoint. Leave the key empty and the demo runs on its rule paths.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# The CIO agent and its challenger: two DIFFERENT models (unset or equal: agent runs are mock)
# The live demo uses anthropic/claude-sonnet-5.5 and google/gemini-3.8-flash; the Copilot router anthropic/claude-haiku-5.5
# LLM_MODEL_CIO=
# LLM_MODEL_CHALLENGER=

# The Copilot router (only picks a tool from the scrubbed question; unset: keyword router, labelled mock)
# LLM_MODEL_COPILOT=

# The bank's own model (llm:onprem) for the client steps when Cấu hình › AI với dữ liệu khách hàng is onprem;
# its host must be on that configuration's onprem_hosts (BRD-NFR-08)
# LLM_ONPREM_BASE_URL=http://localhost:8000/v1
# LLM_ONPREM_MODEL=
# LLM_ONPREM_API_KEY=

# auto (default): AI when LLM_API_KEY is set · on · off
# MF_AI=auto

# Where what clients add is kept (default: data/state.db)
# MF_STATE=data/state.db

# PORT=8030

# The audit chain: set a secret to sign each entry with HMAC-SHA256 instead of plain SHA-256.
# Once a chain has HMAC entries, the key is needed to verify it.
# AUDIT_HMAC_KEY=

# Client data encrypted at rest, per column, AES-256-GCM (BRD-NFR-07, src/control/crypto.py): the first key seals,
# every key listed opens. Make one with `python scripts/rotate_keys.py --new k1`; after adding a key (first), run
# `python scripts/rotate_keys.py`, and drop the old key once `--check` shows nothing under it. Unset: plain text.
# Losing every key loses the sealed data.
# MF_DATA_KEYS=k1=<base64 of 32 bytes>

# Where keys come from (src/control/secrets.py): a Vault-compatible KV v2 store first, then files, then this file.
# The keys above (MF_DATA_KEYS, AUDIT_HMAC_KEY, MF_SESSION_SECRET, MF_INBOX_KEY, MF_ZONE_KEY) belong there in a bank.
# VAULT_ADDR=https://vault.bank.internal
# VAULT_TOKEN=            # or VAULT_TOKEN_FILE=/run/secrets/vault-token
# VAULT_MOUNT=secret
# VAULT_PATH=mr-finance
# MF_SECRETS_DIR=/run/secrets   # one file per name (Docker / Kubernetes secrets)
